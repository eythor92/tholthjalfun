rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Netfang þjálfara (sama og í firebase-config.js).
    function isCoach() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['eythor1992@gmail.com'];
    }

    // Hver iðkandi er eitt skjal. Kóðinn hans er nafnið á skjalinu.
    match /athletes/{code} {
      // Iðkandi getur sótt sitt skjal ef hann veit kóðann, en ekki skoðað listann.
      allow get: if true;
      allow list, create, delete: if isCoach();
      // Þjálfari má breyta öllu. Iðkandi í fjarþjálfun (hópur 2 og 4) má aðeins
      // breyta æfingatölunum sínum, ekki nafni, hópi eða röð.
      allow update: if isCoach()
        || (resource.data.group in [2, 4]
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data', 'updated'])
            && request.resource.data.data is map);
    }

    // Titill verkefnisins og meðaltöl hópanna.
    match /meta/{doc} {
      allow read: if true;
      allow write: if isCoach();
    }
  }
}
